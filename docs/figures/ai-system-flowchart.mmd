%% Editable mermaid twin of ai-system-flowchart.svg. Paste into https://mermaid.live
%% The SVG/PNG is the slide version (a fixed three-row layout mermaid cannot produce);
%% this file lays out as one tall column, which suits a document but not a slide.
%% Verified against packages/ai on 29 September 2026.
flowchart TB
  classDef step fill:#FFFFFF,stroke:#94A7BA,stroke-width:2px,color:#1B2A3A
  classDef core fill:#E6F2F5,stroke:#0E7490,stroke-width:3px,color:#0B3B4A
  classDef gate fill:#FDEDE6,stroke:#C2410C,stroke-width:4px,color:#7A2E0A
  classDef model fill:#F3F0FF,stroke:#6D28D9,stroke-width:2px,color:#3B1A7A
  classDef ok fill:#E7F6EC,stroke:#15803D,stroke-width:3px,color:#14532D
  classDef warn fill:#FFF4DB,stroke:#B45309,stroke-width:3px,color:#78350F

  subgraph ONE["ONCE PER SOURCE · runs in the API"]
    A["1 INGEST · SPLIT<br/>unpdf per page · mammoth · UTF-8<br/>Intl.Segmenter → span_id, offsets, page<br/>SHA-256 source_hash<br/>50 to 50,000 characters, else 400 / 413"]:::step
    B["2 EXTRACT · extractCanonical()<br/>source in the user role, one [span_id] per line<br/>z.toJSONSchema(Canonical) in the prompt<br/>safeParse, one retry quoting the Zod issues<br/>keepKnownRefs() drops invented span ids"]:::core
    C["CANONICAL OBJECT · JSONB<br/>severity · entities · events · affected_systems<br/>indicators · key_facts · recommendations<br/>every item cites source_refs"]:::core
    A --> B --> C
  end

  subgraph TWO["ROUTE + GENERATE · one BullMQ job per format, 3 in flight"]
    D["3 BUILD PROMPT<br/>system = rules + canonical + JSON Schema<br/>user = audience · tone · detail · language<br/>advisory · executive summary · LinkedIn only"]:::step
    E{"4 ROUTER · EGRESS GATE"}:::gate
    G["5a GEMINI · cloud<br/>GEMINI_MODEL · temperature 0<br/>responseSchema · 3 tries, 500·2^n ms"]:::model
    L["5b OLLAMA · on the host<br/>qwen2.5:7b · num_ctx 8192<br/>format = JSON Schema · 180 s timeout"]:::model
    P["6 PARSE · VALIDATE<br/>parseModelJson() → outermost braces<br/>format schema safeParse<br/>invalid → FORMAT_INVALID, no repair"]:::step
    D --> E
    E -- "public · internal" --> G
    E -- "restricted → policy<br/>rate limit → rate_limit" --> L
    G -. "429 or 3 failures → network" .-> L
    G --> P
    L --> P
  end

  subgraph THREE["VERIFY + REPAIR ONCE · plain code, no second model"]
    I["7 CLAIM IDS<br/>collectClaims() · c1 … cn in reading order"]:::step
    V["8 VERIFY · verifyClaims()<br/>① every source_ref exists<br/>② lexical grounding ≥ 0.5<br/>③ identifiers ⊆ cited span<br/>④ source hedges preserved"]:::core
    Q{"9 findings?"}:::gate
    RV["10 REPAIR · exactly ONE call<br/>reviseClaims(): failing claims<br/>+ findings + only their cited spans<br/>replaceClaimNode(), then re-verify"]:::gate
    I --> V --> Q
    Q -- "yes" --> RV
  end

  R1["READY<br/>passed · fixes[] kept"]:::ok
  R2["FLAGGED<br/>open_issues[] → the reviewer decides"]:::warn

  C ==> D
  P ==> I
  Q -- "no findings" --> R1
  RV -- "clean" --> R1
  RV -- "still failing" --> R2
