# Copy to .env (never committed) and fill in your own values.

# Docker host ports. Change both a port here and the matching URL below if 5432 or 6379 is taken.
PG_PORT=5432
REDIS_PORT=6379

# Server (B)
DATABASE_URL=postgresql://ps154:ps154dev@localhost:5432/ps154
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-string
PORT=8080
WEB_ORIGIN=http://localhost:5173

# AI engine (D)
# Cloud provider: gemini or groq. The engine reads the key that matches.
AI_PROVIDER=gemini
# Google Gemini. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model id your key can use; list them at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash-lite
# Groq (used only when AI_PROVIDER=groq). CLOUD_MODEL is the Groq model id.
GROQ_API_KEY=
CLOUD_MODEL=llama-3.3-70b-versatile
# Requests per minute the router allows itself. Free-tier keys are far lower than paid ones; check your quota.
CLOUD_RPM=10
OLLAMA_URL=http://localhost:11434
LOCAL_MODEL=qwen2.5:7b
LOCAL_NUM_CTX=8192
LOCAL_TIMEOUT_MS=180000
REDACT_TERMS=
DEMO_PERTURB=0
